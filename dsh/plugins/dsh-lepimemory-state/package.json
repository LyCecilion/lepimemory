{
    "name": "@dsh-external/dsh-lepimemory-state",
    "version": "0.0.1",
    "private": true,
    "description": "Lepimemory 状态注入插件：读取一份持久化 JSON 状态（mood/relation/reasons），在每次 prompt 组装时实时渲染为 system prompt section。",
    "type": "module",
    "main": "./lib/index.js",
    "exports": {
        ".": {
            "default": "./lib/index.js"
        }
    },
    "files": [
        "lib",
        "cordis.patch.yml"
    ],
    "dsh": {
        "manifestVersion": 1,
        "bundle": {
            "patch": "./cordis.patch.yml"
        }
    }
}
