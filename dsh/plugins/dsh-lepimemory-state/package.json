{
    "name": "@dsh-external/dsh-lepimemory-state",
    "version": "0.0.1",
    "private": true,
    "description": "Lepimemory 角色运行时插件：持久化状态（state.json）+ 事件驱动状态机 + 心境衰减 + 自有审计（audit.jsonl）+ 记忆桥（Hindsight 召回→归因→注入，recall.jsonl）。",
    "type": "module",
    "main": "./lib/index.js",
    "exports": {
        ".": {
            "default": "./lib/index.js"
        }
    },
    "files": [
        "lib",
        "cordis.patch.yml"
    ],
    "dsh": {
        "manifestVersion": 1,
        "bundle": {
            "patch": "./cordis.patch.yml"
        }
    }
}
