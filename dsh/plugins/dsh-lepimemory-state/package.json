{
    "name": "@dsh-external/dsh-lepimemory-state",
    "version": "0.0.1",
    "private": true,
    "description": "Lepimemory 角色运行时插件：SQLite 状态与审计、逐候选理解与准入、授权和 canonical 遗忘、可核实 Hindsight 写入与政策召回、manage_memory 控制、write_note 真实便条与 React 操作者面板。",
    "type": "module",
    "main": "./lib/index.js",
    "exports": {
        ".": {
            "default": "./lib/index.js"
        },
        "./client": "./client.js"
    },
    "files": [
        "lib",
        "client.js",
        "cordis.patch.yml",
        "assets"
    ],
    "dependencies": {
        "@deepseek-ai/dsh-llm": "0.1.7-rc.2",
        "@deepseek-ai/dsh-tools": "0.1.7-rc.2",
        "@deepseek-ai/dsh-session": "0.1.7-rc.2",
        "@deepseek-ai/dsh-compaction": "0.1.7-rc.2",
        "@deepseek-ai/dsh-system-prompt": "0.1.7-rc.2"
    },
    "peerDependencies": {
        "@deepseek-ai/dsh": "0.1.7-rc.2"
    },
    "dsh": {
        "manifestVersion": 1,
        "bundle": {
            "patch": "./cordis.patch.yml"
        },
        "client": {
            "platform": "web",
            "inject": [
                "@deepseek-ai/dsh-client-ui-renderer",
                "@deepseek-ai/dsh-client-ui-conversation",
                "@deepseek-ai/dsh-client-ui-session",
                "@deepseek-ai/dsh-client-locale",
                "@deepseek-ai/dsh-client-ui-sidebar-right"
            ]
        }
    }
}
