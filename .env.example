# Lepimemory 环境变量示例
# 复制为 .env 再填（.env 已在 .gitignore；绝不提交真 key）
# 全部可留空——留空 = 共享连接 unconfigured：只读界面可用，不生成 provider/default-model，
# 也不会回落到任何默认官方 URL。要对话就必须显式填共享连接（URL 与 key 成对）。

# ── 共享 LLM 连接（OpenAI-compatible）──────────────────
# 两项要么都填、要么都空；只填一项会在启动时报 LEPI_CONNECTION_INCOMPLETE。
LEPI_LLM_BASE_URL=                   # 例如 https://your-endpoint.example/v1（不进仓库）
LEPI_LLM_API_KEY=

# ── 模型（独立固定，不随会话模型切换）──────────────────
LEPI_ROLE_MODEL=deepseek-flash
LEPI_PROCESS_MODEL=deepseek-flash
# LEPI_CONTROL_FALLBACK_MODEL 默认取 LEPI_ROLE_MODEL；启动时独立验证后固定。
# LEPI_HINDSIGHT_MODEL 默认 deepseek-flash。

# ── 每路由连接 override（可选）────────────────────────
# 每对未设置则继承上面的共享组。要覆盖必须 URL/key 成组，不部分继承。
# LEPI_ROLE_BASE_URL=                # + LEPI_ROLE_API_KEY
# LEPI_PROCESS_BASE_URL=             # + LEPI_PROCESS_API_KEY
# LEPI_CONTROL_FALLBACK_BASE_URL=    # + LEPI_CONTROL_FALLBACK_API_KEY
# LEPI_HINDSIGHT_BASE_URL=           # + LEPI_HINDSIGHT_API_KEY（Hindsight 自身用的 LLM 连接）

# ── 记忆微服务与准入服务 ──────────────────────────────
LEPI_HINDSIGHT_URL=http://127.0.0.1:8888
LEPI_LAYA_URL=http://127.0.0.1:8000
LEPI_LAYA_API_KEY=                   # 独立服务 token，不继承云 key
LEPI_ADMISSION_BACKEND=laya          # 仅可选 generative；显式选择，运行时不自动切换

# ── 记忆库与时区 ──────────────────────────────────────
LEPI_BANK=lepimemory-v2              # 拒绝旧 'lepimemory'；演示可用 lepimemory-demo-*
LEPI_TIME_ZONE=Asia/Shanghai         # 以 Intl 校验；消息中明确时区优先

# ── 超时 / 时限（正安全整数，毫秒）────────────────────
# LEPI_CONSENT_TIMEOUT_MS=600000
# LEPI_TASK_TTL_MS=604800000
# LEPI_GRANT_TTL_MS=2592000000
# LEPI_INFERENCE_HALF_LIFE_MS=1209600000

# ── 预算（正安全整数）─────────────────────────────────
# LEPI_CONTEXT_MAX_CHARS=12000
# LEPI_EVIDENCE_MAX_CALLS=4
# LEPI_PROCESS_MAX_TOKENS=4096
# LEPI_PROCESS_TIMEOUT_MS=30000
# LEPI_CONTROL_TIMEOUT_MS=20000

# ── Laya 准入阈值（demo 起点，非校准概率）─────────────
# 每组需满足 0 ≤ reject < accept ≤ 1。
# LEPI_LAYA_ACCEPT_DURABLE=0.65
# LEPI_LAYA_REJECT_DURABLE=0.2
# LEPI_LAYA_ACCEPT_TRANSIENT=0.85
# LEPI_LAYA_REJECT_TRANSIENT=0.35

# ── 运行位置 ──────────────────────────────────────────
# PORT=3080                          # dsh Web UI 端口
# DSH_HOME=./.dsh                    # dsh 状态目录（默认仓库内 .dsh）

# ── 部署检索栈（样例字段；不要在此重复内部 LLM key）──
HINDSIGHT_API_EMBEDDINGS_LOCAL_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
HINDSIGHT_API_RERANKER_LOCAL_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
HF_ENDPOINT=https://hf-mirror.com

# ── 旧 .env 迁移 ──────────────────────────────────────
# 旧键会在首次加载时一次性迁移（先备份 .env.legacy-<timestamp>，模式 0600）：
#   GEEK_TECH_CLUB_API_KEY        → LEPI_LLM_API_KEY（保留已有 LEPI_LLM_BASE_URL）
#   HINDSIGHT_API_LLM_BASE_URL    → LEPI_HINDSIGHT_BASE_URL
#   HINDSIGHT_API_LLM_API_KEY     → LEPI_HINDSIGHT_API_KEY
#   HINDSIGHT_API_LLM_MODEL       → LEPI_HINDSIGHT_MODEL
#   HINDSIGHT_API_LLM_PROVIDER    → 删除
# endpoint 缺失只报告字段名，不猜地址。迁移后旧别名不再被正常解析支持。
