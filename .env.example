# Lepimemory 环境变量示例
# 复制为 .env 再填（.env 已在 .gitignore；绝不提交真 key）
# 全部可留空——留空时走零 LLM 成本路径，演示前几步仍可运行。

# ── Hindsight（记忆微服务）────────────────────────────
# key 留空 → 不启用 LLM 调用；完全零 key 可把 PROVIDER 设为 none（chunks 模式）。
HINDSIGHT_API_LLM_PROVIDER=openai
HINDSIGHT_API_LLM_BASE_URL=          # 你的 OpenAI 兼容端点，如 https://api.deepseek.com/v1
HINDSIGHT_API_LLM_MODEL=deepseek-flash
HINDSIGHT_API_LLM_API_KEY=

# ── Hindsight 检索栈（中文库必需）──────────────────────
# 镜像默认是纯英文模型（bge-small-en + ms-marco），跑中文会分数饱和；换 384 维多语言模型（免改 schema）
HINDSIGHT_API_EMBEDDINGS_LOCAL_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
HINDSIGHT_API_RERANKER_LOCAL_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
HF_ENDPOINT=https://hf-mirror.com   # 容器连不上 huggingface.co；首次启动经此拉模型

# ── dsh 自定义模型端点 ────────────────────────────────
# 与 dsh/profiles/lepimemory/cordis.patch.yml 对应：
#   GEEK_TECH_CLUB_API_KEY → apiKeyEnv；LEPI_LLM_BASE_URL → baseURL（!!js 读取）
# 端点地址与 key 都不进仓库。
LEPI_LLM_BASE_URL=                   # 同上；留空时 dsh 回落 api.deepseek.com
GEEK_TECH_CLUB_API_KEY=

# ── 可选：本地运行参数 ────────────────────────────────
# PORT=3080            # dsh Web UI 端口（本机 3080 被占用时改这个）
# DSH_HOME=./.dsh      # dsh 状态目录（make reset 会清空）
